# Copy this file to .env and fill in your own values.
# Never commit .env: it is ignored by git.

# --- Groq (default cloud provider) ----------------------------------------- #
# Required for agent / web answers. Groq keys start with "gsk_".
GROQ_API_KEY=
# Optional overrides:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=llama3-8b-8192
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Local Ollama (optional, off by default) ------------------------------- #
# Set USE_LOCAL_LLM=True only if you have Ollama installed and running locally.
# Jarvis will then use Ollama for agent replies instead of Groq. Leaving this
# unset keeps the integration completely dormant: no Ollama request is made and
# the normal Groq setup is unchanged.
#
# Start Ollama first, for example:
#   ollama serve
#   ollama pull llama3
USE_LOCAL_LLM=False
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- Voice / text mode ----------------------------------------------------- #
# JARVIS_TEXT=1         # type commands instead of speaking
# JARVIS_MUTE=1         # disable spoken replies
# JARVIS_OFFLINE=1      # use the local router only; never call an LLM
# JARVIS_TTS_VOICE=en-GB-RyanNeural

# --- MCP tool servers (optional) ------------------------------------------- #
# JSON object mapping a server name to the command that starts it. Jarvis
# exposes each tool to the LLM as mcp__<server>__<tool>. See docs/mcp-setup.md.
#
# MCP_SERVERS='{"filesystem": "npx -y @modelcontextprotocol/server-filesystem /home/me/Documents"}'
#
# The object form is useful for environment variables and working directories:
# MCP_SERVERS='{"brave": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-brave-search"], "env": {"BRAVE_API_KEY": "..."}}}'
#
# Optional tuning:
# MCP_TIMEOUT=15          # seconds allowed for startup and each tool call
# MCP_RETRY_SECONDS=30    # how long to wait before retrying a failed server

# --- Voice endpointing and semantic memory --------------------------------- #
# Silero VAD ends the phrase ~0.4 s after you stop talking instead of waiting
# for the 2 s RMS window. It is used automatically when installed; set this to
# 0 to force the RMS fallback.
# JARVIS_SILERO_VAD=1
# JARVIS_VAD_THRESHOLD=0.5
# JARVIS_VAD_START_MS=64
# JARVIS_VAD_END_MS=400
#
# ChromaDB stores long-term memories at ~/.jarvis/chroma_db and retrieves the
# three most relevant ones per turn. SQLite remains the fallback.
# JARVIS_SEMANTIC_MEMORY=1
# JARVIS_CHROMA_DB=~/.jarvis/chroma_db
